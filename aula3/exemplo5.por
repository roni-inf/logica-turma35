programa
{
	
	funcao inicio()
	{
	inteiro numero, total=0 
		faca{
			escreva("Digite o n°:")
			leia(numero)
			total = total + numero
		}enquanto(numero != 0)

		escreva("Fim de Programa!")
		escreva("total:",total)

	}
}
